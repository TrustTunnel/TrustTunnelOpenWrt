/build/
/dist/
*.apk
*.tar.gz

# LuCI GUI test harness artifacts (tests/gui/run.sh): the pinned luci-base
# resources cache and the playwright node_modules are fetched/generated,
# never committed.
tests/gui/node_modules/
tests/gui/.cache/
tests/gui/.artifacts/

# Generated by tests/backend/test_backend_contract.sh: the shared ucode
# module travels next to the copied backend at run time. (The backend
# copy itself is tracked and refreshed in sync with the live file.)
tests/backend/mod/trusttunnel.uc

# Local tool settings and agent workspaces: machine-specific settings and
# intermediate reports that have no place in history.
.claude/
.superpowers/

# User documentation lives in the repository root and is tracked: README.md
# is the landing page and the topic documents sit next to it. If another
# user-facing document is added, its place is also in the root — otherwise
# it will silently fall out of the repository and a link to it from README
# will end up broken.

# MIGRATION.md is the one-time repository-move plan: it is maintained
# locally only and must never be committed (it must not travel to the
# target repository).
MIGRATION.md

# Editor and file manager junk.
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
